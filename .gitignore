# =============================================================================
# Retro Arcade Collection — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Distribution / packaging (la spec PyInstaller vive in packaging/) ---
build/
dist/
*.egg-info/
*.egg
MANIFEST
*.manifest
*.exe
*.app
*.dmg

# --- Virtual environments ---
venv/
env/
ENV/
.venv/
.env/

# --- File generati dal gioco ---
scores.json
scores.json.corrupt
.scores-*.tmp
retro_arcade.log
/screenshots/
retro_arcade_generated.png
*.log

# Backup creati dai tool clean_nulls / fix_encoding
*.bak
*.bak_*

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Testing / lint / coverage ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- OS-specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Configurazione locale (eventuale) ---
.env
config.local.*
